FROM python@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app
RUN python -m pip install --no-cache-dir uv==0.12.7
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts/render_alertmanager_config.py ./scripts/render_alertmanager_config.py
COPY reports/read_models/P15_SNAPSHOT.json ./reports/read_models/P15_SNAPSHOT.json
RUN uv sync --frozen --no-dev --no-editable

FROM python@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e

ENV PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
RUN groupadd --gid 10001 aegisquant \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin aegisquant \
    && mkdir -p /var/log/aegisquant \
    && chown -R 10001:10001 /var/log/aegisquant
COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --from=builder --chown=10001:10001 /app/src /app/src
COPY --from=builder --chown=10001:10001 /app/scripts /app/scripts
COPY --from=builder --chown=10001:10001 /app/reports /app/reports
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=2).read()"]
CMD ["uvicorn", "aegisquant.api.main:create_production_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-server-header", "--no-access-log"]
