+        raise ValueError("partition ends must increase")
+    kept: list[tuple[SampleSpan, ...]] = []
+    removed: set[str] = set()
+    for index, partition in enumerate(partitions):
+        future = tuple(item for later in partitions[index + 1 :] for item in later)
+        bad = {
