{
  "status": "NOT_RECEIVED",
  "schema": {
    "$defs": {
      "ClosedLiquidityBar": {
        "additionalProperties": false,
        "description": "Evidence for an exclusive UTC four-hour close, without a price/replay interface.",
        "properties": {
          "close_time": {
            "format": "date-time",
            "title": "Close Time",
            "type": "string"
          },
          "available_time": {
            "format": "date-time",
            "title": "Available Time",
            "type": "string"
          },
          "quote_turnover": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "ge": "0",
            "title": "Quote Turnover"
          },
          "source_sha256": {
            "title": "Source Sha256",
            "type": "string"
          }
        },
        "required": [
          "close_time",
          "available_time",
          "quote_turnover",
          "source_sha256"
        ],
        "title": "ClosedLiquidityBar",
        "type": "object"
      },
      "LiquidityEvidence": {
        "additionalProperties": false,
        "properties": {
          "quote_method": {
            "enum": [
              "EXCHANGE_QUOTE_TURNOVER",
              "TRADE_QUOTE_SUM",
              "BASE_VOLUME_TIMES_CLOSE_PROXY",
              "UNKNOWN",
              "SYNTHETIC"
            ],
            "title": "Quote Method",
            "type": "string"
          },
          "bars": {
            "items": {
              "$ref": "#/$defs/ClosedLiquidityBar"
            },
            "title": "Bars",
            "type": "array"
          },
          "detail_sha256": {
            "title": "Detail Sha256",
            "type": "string"
          }
        },
        "required": [
          "quote_method",
          "bars",
          "detail_sha256"
        ],
        "title": "LiquidityEvidence",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "instrument_id": {
        "title": "Instrument Id",
        "type": "string"
      },
      "window_start": {
        "format": "date-time",
        "title": "Window Start",
        "type": "string"
      },
      "window_end": {
        "format": "date-time",
        "title": "Window End",
        "type": "string"
      },
      "available_time": {
        "format": "date-time",
        "title": "Available Time",
        "type": "string"
      },
      "complete_history_4h_bars": {
        "minimum": 0,
        "title": "Complete History 4H Bars",
        "type": "integer"
      },
      "trailing_quote_volume": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ],
        "ge": "0",
        "title": "Trailing Quote Volume"
      },
      "source_sha256": {
        "title": "Source Sha256",
        "type": "string"
      },
      "revision": {
        "default": 1,
        "minimum": 1,
        "title": "Revision",
        "type": "integer"
      },
      "revision_time": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Revision Time"
      },
      "evidence": {
        "anyOf": [
          {
            "$ref": "#/$defs/LiquidityEvidence"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "instrument_id",
      "window_start",
      "window_end",
      "available_time",
      "complete_history_4h_bars",
      "trailing_quote_volume",
      "source_sha256"
    ],
    "title": "LiquidityObservation",
    "type": "object"
  },
  "source": {
    "path": null,
    "sha256": null
  },
  "records": null
}
