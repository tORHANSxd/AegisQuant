+                "cost": cost,
+                "segment": "continuous",
+                "folder": f"{R5}/runs/{arm}/{symbol}/{cost}",
+                "hours": None if arm == "G0" else settings["review_interval_hours"],
+            }
+        )
+    require(len(tasks) == 55, "AQ-SAVED-EVIDENCE-R5-SCOPE")
+    r4_registry = sources["r4_registry"]
