+        ):
+            raise PermissionError("AQ-HOLDOUT-REPARSE-PATH-FORBIDDEN")
+    if not path.resolve().is_relative_to(root):
+        raise PermissionError("AQ-HOLDOUT-PATH-OUTSIDE-PROJECT")
+    return path
