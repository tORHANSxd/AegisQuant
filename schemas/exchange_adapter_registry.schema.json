{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegisquant.local/schemas/exchange-adapter-registry-v1.json",
  "title": "AegisQuant P00 exchange adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "live_trading_locked",
    "order_submission_enabled",
    "public_market_data_adapters",
    "paper_adapters",
    "testnet_adapters",
    "live_adapters"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "live_trading_locked": { "const": true },
    "order_submission_enabled": { "const": false },
    "public_market_data_adapters": { "type": "array", "maxItems": 0 },
    "paper_adapters": { "type": "array", "maxItems": 0 },
    "testnet_adapters": { "type": "array", "maxItems": 0 },
    "live_adapters": { "type": "array", "maxItems": 0 }
  }
}
