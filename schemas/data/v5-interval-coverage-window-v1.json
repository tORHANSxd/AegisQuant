{
  "$defs": {
    "CouncilHorizon": {
      "enum": [
        "5s",
        "15s",
        "30s",
        "1m",
        "3m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "12h",
        "1d",
        "3d",
        "7d"
      ],
      "title": "CouncilHorizon",
      "type": "string"
    },
    "IntervalCoverageObservation": {
      "additionalProperties": false,
      "properties": {
        "outcome_available_at": {
          "format": "date-time",
          "title": "Outcome Available At",
          "type": "string"
        },
        "predicted_at": {
          "format": "date-time",
          "title": "Predicted At",
          "type": "string"
        },
        "predicted_lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Predicted Lower"
        },
        "predicted_median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Predicted Median"
        },
        "predicted_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Predicted Upper"
        },
        "realized_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Realized Value"
        },
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "predicted_lower",
        "predicted_median",
        "predicted_upper",
        "realized_value",
        "predicted_at",
        "outcome_available_at"
      ],
      "title": "IntervalCoverageObservation",
      "type": "object"
    },
    "MarketRegime": {
      "enum": [
        "TREND",
        "MEAN_REVERSION",
        "LOW_VOL_COMPRESSION",
        "VOL_EXPANSION",
        "LIQUIDITY_CRISIS",
        "NEWS_SHOCK",
        "LIQUIDATION_CASCADE",
        "FUNDING_DISLOCATION",
        "CORRELATION_BREAKDOWN",
        "RISK_ON",
        "RISK_OFF",
        "UNKNOWN",
        "OOD"
      ],
      "title": "MarketRegime",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.v5-interval-coverage-window/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Asset Id",
      "type": "string"
    },
    "calibration_artifact_sha256": {
      "title": "Calibration Artifact Sha256",
      "type": "string"
    },
    "dataset_manifest_sha256": {
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "horizon": {
      "$ref": "#/$defs/CouncilHorizon"
    },
    "model_revision_sha256": {
      "title": "Model Revision Sha256",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/IntervalCoverageObservation"
      },
      "minItems": 2,
      "title": "Observations",
      "type": "array"
    },
    "regime": {
      "$ref": "#/$defs/MarketRegime"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "window_sha256": {
      "title": "Window Sha256",
      "type": "string"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "horizon",
    "regime",
    "model_revision_sha256",
    "dataset_manifest_sha256",
    "calibration_artifact_sha256",
    "window_start",
    "window_end",
    "decision_time",
    "observations",
    "window_sha256"
  ],
  "title": "IntervalCoverageWindow",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.v5-interval-coverage-window",
  "x-aegisquant-schema-version": "1.0.0"
}
