{
  "$defs": {
    "Product": {
      "enum": [
        "SPOT",
        "USD_M"
      ],
      "title": "Product",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "default": {
            "value": "binance_public"
          },
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Provider Id",
          "type": "string"
        },
        "raw_sha256": {
          "title": "Raw Sha256",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_request_hash": {
          "title": "Source Request Hash",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_request_hash",
        "raw_sha256"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "VALID",
        "WARNING",
        "QUARANTINE"
      ],
      "title": "QualityStatus",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.binance-instrument-snapshot/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available_time": {
      "format": "date-time",
      "title": "Available Time",
      "type": "string"
    },
    "base_asset": {
      "title": "Base Asset",
      "type": "string"
    },
    "contract_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Contract Size"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "expiry_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expiry Time"
    },
    "ingest_time": {
      "format": "date-time",
      "title": "Ingest Time",
      "type": "string"
    },
    "instrument_id": {
      "title": "Instrument Id",
      "type": "string"
    },
    "max_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Quantity"
    },
    "min_notional": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Min Notional"
    },
    "min_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Min Quantity"
    },
    "processed_time": {
      "format": "date-time",
      "title": "Processed Time",
      "type": "string"
    },
    "product": {
      "$ref": "#/$defs/Product"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "quality_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quality Codes",
      "type": "array"
    },
    "quality_status": {
      "$ref": "#/$defs/QualityStatus"
    },
    "quote_asset": {
      "title": "Quote Asset",
      "type": "string"
    },
    "revision_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision Time"
    },
    "settlement_asset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Settlement Asset"
    },
    "source_snapshot_id": {
      "title": "Source Snapshot Id",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "step_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Step Size"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "tick_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Tick Size"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Valid To"
    }
  },
  "required": [
    "product",
    "symbol",
    "event_time",
    "available_time",
    "ingest_time",
    "processed_time",
    "quality_status",
    "provenance",
    "instrument_id",
    "base_asset",
    "quote_asset",
    "settlement_asset",
    "contract_size",
    "status",
    "tick_size",
    "step_size",
    "min_quantity",
    "max_quantity",
    "min_notional",
    "expiry_time",
    "valid_from",
    "valid_to",
    "source_snapshot_id"
  ],
  "title": "InstrumentSnapshot",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.binance-instrument-snapshot",
  "x-aegisquant-schema-version": "1.0.0"
}
