  "required": [
    "dataset_id",
    "dataset_sha256",
    "evidence_tier",
    "as_of_time",
    "created_at",
    "rows",
    "source_dataset_ids",
    "feature_snapshot_hashes",
    "label_hashes",
    "universe_snapshot_hashes",
    "feature_definition_hashes",
    "label_definition_hashes",
    "cost_policy_sha256"
  ],
  "title": "EventResponseDataset",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.event-response-dataset",
  "x-aegisquant-schema-version": "1.0.0"
