    "EvidenceTier": {
      "description": "Mutually exclusive evidence maturity levels from the v5 SSOT.",
      "enum": [
        "FIXTURE",
        "SYNTHETIC",
        "DEVELOPMENT",
        "OOS_DEVELOPMENT",
        "FINAL_HOLDOUT",
        "PAPER_FORWARD",
        "SHADOW_FORWARD",
        "TESTNET_FORWARD",
        "CANARY_LIVE",
        "LIVE"
      ],
      "title": "EvidenceTier",
      "type": "string"
    }
