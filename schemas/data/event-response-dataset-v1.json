  "$id": "https://aegisquant.local/schemas/aegisquant.event-response-dataset/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed, revision-aware causal response dataset.",
  "properties": {
    "as_of_time": {
      "format": "date-time",
      "title": "As Of Time",
      "type": "string"
    },
    "cost_policy_sha256": {
      "title": "Cost Policy Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_sha256": {
      "title": "Dataset Sha256",
      "type": "string"
    },
    "evidence_tier": {
      "$ref": "#/$defs/EvidenceTier"
    },
    "feature_definition_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Feature Definition Hashes",
      "type": "array"
    },
    "feature_snapshot_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Feature Snapshot Hashes",
      "type": "array"
    },
    "label_definition_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Label Definition Hashes",
      "type": "array"
    },
    "label_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Label Hashes",
      "type": "array"
    },
    "point_in_time": {
      "const": true,
      "default": true,
      "title": "Point In Time",
      "type": "boolean"
    },
    "revision_aware": {
      "const": true,
      "default": true,
      "title": "Revision Aware",
      "type": "boolean"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/EventResponseRow"
      },
      "minItems": 4,
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shuffle": {
      "const": false,
      "default": false,
      "title": "Shuffle",
      "type": "boolean"
    },
    "source_dataset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Dataset Ids",
      "type": "array"
    },
    "universe_snapshot_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Universe Snapshot Hashes",
      "type": "array"
    }
