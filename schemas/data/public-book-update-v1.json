    },
    "previous_sequence": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Sequence"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "venue": {
      "$ref": "#/$defs/Venue"
