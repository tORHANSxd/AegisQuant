{
  "$defs": {
    "Product": {
      "enum": [
        "SPOT",
        "USD_M"
      ],
      "title": "Product",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "default": {
            "value": "binance_public"
          },
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Provider Id",
          "type": "string"
        },
        "raw_sha256": {
          "title": "Raw Sha256",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_request_hash": {
          "title": "Source Request Hash",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_request_hash",
        "raw_sha256"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualityStatus": {
      "enum": [
        "VALID",
        "WARNING",
        "QUARANTINE"
      ],
      "title": "QualityStatus",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.binance-depth-delta/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asks": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          }
        ],
        "type": "array"
      },
      "title": "Asks",
      "type": "array"
    },
    "available_time": {
      "format": "date-time",
      "title": "Available Time",
      "type": "string"
    },
    "bids": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          }
        ],
        "type": "array"
      },
      "title": "Bids",
      "type": "array"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "final_update_id": {
      "minimum": 0,
      "title": "Final Update Id",
      "type": "integer"
    },
    "first_update_id": {
      "minimum": 0,
      "title": "First Update Id",
      "type": "integer"
    },
    "ingest_time": {
      "format": "date-time",
      "title": "Ingest Time",
      "type": "string"
    },
    "previous_final_update_id": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Final Update Id"
    },
    "processed_time": {
      "format": "date-time",
      "title": "Processed Time",
      "type": "string"
    },
    "product": {
      "$ref": "#/$defs/Product"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "quality_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quality Codes",
      "type": "array"
    },
    "quality_status": {
      "$ref": "#/$defs/QualityStatus"
    },
    "revision_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision Time"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    }
  },
  "required": [
    "product",
    "symbol",
    "event_time",
    "available_time",
    "ingest_time",
    "processed_time",
    "quality_status",
    "provenance",
    "first_update_id",
    "final_update_id",
    "bids",
    "asks"
  ],
  "title": "DepthDeltaRecord",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.binance-depth-delta",
  "x-aegisquant-schema-version": "1.0.0"
}
