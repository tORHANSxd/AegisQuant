{
  "$defs": {
    "CouncilHorizon": {
      "enum": [
        "5s",
        "15s",
        "30s",
        "1m",
        "3m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "12h",
        "1d",
        "3d",
        "7d"
      ],
      "title": "CouncilHorizon",
      "type": "string"
    },
    "MarketRegime": {
      "enum": [
        "TREND",
        "MEAN_REVERSION",
        "LOW_VOL_COMPRESSION",
        "VOL_EXPANSION",
        "LIQUIDITY_CRISIS",
        "NEWS_SHOCK",
        "LIQUIDATION_CASCADE",
        "FUNDING_DISLOCATION",
        "CORRELATION_BREAKDOWN",
        "RISK_ON",
        "RISK_OFF",
        "UNKNOWN",
        "OOD"
      ],
      "title": "MarketRegime",
      "type": "string"
    },
    "StackingWeights": {
      "additionalProperties": false,
      "properties": {
        "maximum_weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Maximum Weight"
        },
        "weights": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "ge": "0",
            "le": "1"
          },
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "weights",
        "maximum_weight"
      ],
      "title": "StackingWeights",
      "type": "object"
    },
    "WeightEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "title": "Artifact Sha256",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/WeightEvidenceSource"
        }
      },
      "required": [
        "source",
        "artifact_sha256"
      ],
      "title": "WeightEvidenceBinding",
      "type": "object"
    },
    "WeightEvidenceSource": {
      "enum": [
        "VALIDATION",
        "CALIBRATION",
        "FORWARD"
      ],
      "title": "WeightEvidenceSource",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.v5-statistical-weight-proposal/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Asset Id",
      "type": "string"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "evidence_bindings": {
      "items": {
        "$ref": "#/$defs/WeightEvidenceBinding"
      },
      "minItems": 1,
      "title": "Evidence Bindings",
      "type": "array"
    },
    "final_holdout_used": {
      "const": false,
      "default": false,
      "title": "Final Holdout Used",
      "type": "boolean"
    },
    "horizon": {
      "$ref": "#/$defs/CouncilHorizon"
    },
    "previous_weights": {
      "$ref": "#/$defs/StackingWeights"
    },
    "proposal_sha256": {
      "title": "Proposal Sha256",
      "type": "string"
    },
    "proposed_weights": {
      "$ref": "#/$defs/StackingWeights"
    },
    "regime": {
      "$ref": "#/$defs/MarketRegime"
    },
    "split_sha256": {
      "title": "Split Sha256",
      "type": "string"
    },
    "training_cutoff": {
      "format": "date-time",
      "title": "Training Cutoff",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "horizon",
    "regime",
    "training_cutoff",
    "available_at",
    "previous_weights",
    "proposed_weights",
    "evidence_bindings",
    "split_sha256",
    "proposal_sha256"
  ],
  "title": "StatisticalWeightProposal",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.v5-statistical-weight-proposal",
  "x-aegisquant-schema-version": "1.0.0"
}
