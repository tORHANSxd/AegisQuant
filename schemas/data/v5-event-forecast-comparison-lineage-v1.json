{
  "$defs": {
    "CouncilHorizon": {
      "enum": [
        "5s",
        "15s",
        "30s",
        "1m",
        "3m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "12h",
        "1d",
        "3d",
        "7d"
      ],
      "title": "CouncilHorizon",
      "type": "string"
    },
    "MarketRegime": {
      "enum": [
        "TREND",
        "MEAN_REVERSION",
        "LOW_VOL_COMPRESSION",
        "VOL_EXPANSION",
        "LIQUIDITY_CRISIS",
        "NEWS_SHOCK",
        "LIQUIDATION_CASCADE",
        "FUNDING_DISLOCATION",
        "CORRELATION_BREAKDOWN",
        "RISK_ON",
        "RISK_OFF",
        "UNKNOWN",
        "OOD"
      ],
      "title": "MarketRegime",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.v5-event-forecast-comparison-lineage/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact OOS sample, split, and budget identity shared by every ablation arm.",
  "properties": {
    "asset_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Asset Id",
      "type": "string"
    },
    "calibration_end": {
      "format": "date-time",
      "title": "Calibration End",
      "type": "string"
    },
    "calibration_sample_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Calibration Sample Ids",
      "type": "array"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "embargo_seconds": {
      "minimum": 1,
      "title": "Embargo Seconds",
      "type": "integer"
    },
    "evaluation_available_at": {
      "format": "date-time",
      "title": "Evaluation Available At",
      "type": "string"
    },
    "final_holdout_opened": {
      "const": false,
      "default": false,
      "title": "Final Holdout Opened",
      "type": "boolean"
    },
    "fold_id": {
      "minLength": 1,
      "title": "Fold Id",
      "type": "string"
    },
    "horizon": {
      "$ref": "#/$defs/CouncilHorizon"
    },
    "instrument_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Instrument Id",
      "type": "string"
    },
    "label_dataset_manifest_sha256": {
      "title": "Label Dataset Manifest Sha256",
      "type": "string"
    },
    "lineage_sha256": {
      "title": "Lineage Sha256",
      "type": "string"
    },
    "purge_seconds": {
      "minimum": 1,
      "title": "Purge Seconds",
      "type": "integer"
    },
    "regime": {
      "$ref": "#/$defs/MarketRegime"
    },
    "resource_budget_sha256": {
      "title": "Resource Budget Sha256",
      "type": "string"
    },
    "split_sha256": {
      "title": "Split Sha256",
      "type": "string"
    },
    "test_end": {
      "format": "date-time",
      "title": "Test End",
      "type": "string"
    },
    "test_sample_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Test Sample Ids",
      "type": "array"
    },
    "test_start": {
      "format": "date-time",
      "title": "Test Start",
      "type": "string"
    },
    "training_end": {
      "format": "date-time",
      "title": "Training End",
      "type": "string"
    },
    "training_sample_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Training Sample Ids",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "instrument_id",
    "horizon",
    "regime",
    "fold_id",
    "split_sha256",
    "label_dataset_manifest_sha256",
    "resource_budget_sha256",
    "decision_time",
    "training_end",
    "calibration_end",
    "test_start",
    "test_end",
    "evaluation_available_at",
    "purge_seconds",
    "embargo_seconds",
    "training_sample_ids",
    "calibration_sample_ids",
    "test_sample_ids",
    "lineage_sha256"
  ],
  "title": "EventForecastComparisonLineage",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.v5-event-forecast-comparison-lineage",
  "x-aegisquant-schema-version": "1.0.0"
}
