{
  "$id": "https://aegisquant.local/schemas/aegisquant.lead-lag-observation/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_key": {
      "title": "Event Key",
      "type": "string"
    },
    "exposure_id": {
      "title": "Exposure Id",
      "type": "string"
    },
    "follower_event_time": {
      "format": "date-time",
      "title": "Follower Event Time",
      "type": "string"
    },
    "follower_provider_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Follower Provider Id",
      "type": "string"
    },
    "lag_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Lag Ms"
    },
    "leader_event_time": {
      "format": "date-time",
      "title": "Leader Event Time",
      "type": "string"
    },
    "leader_provider_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Leader Provider Id",
      "type": "string"
    }
  },
  "required": [
    "exposure_id",
    "event_key",
    "leader_provider_id",
    "follower_provider_id",
    "leader_event_time",
    "follower_event_time",
    "lag_ms"
  ],
  "title": "LeadLagObservation",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.lead-lag-observation",
  "x-aegisquant-schema-version": "1.0.0"
}
