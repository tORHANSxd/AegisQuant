{
  "$id": "https://aegisquant.local/schemas/aegisquant.v5-net-edge-scenario/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "execution_cost": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": "0",
      "title": "Execution Cost"
    },
    "gross_edge": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Gross Edge"
    },
    "net_edge": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Net Edge"
    },
    "probability": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": "0",
      "le": "1",
      "title": "Probability"
    },
    "queue_adjusted_gross_edge": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Queue Adjusted Gross Edge"
    },
    "queue_probability": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": "0",
      "le": "1",
      "title": "Queue Probability"
    },
    "scenario_id": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "probability",
    "gross_edge",
    "queue_probability",
    "queue_adjusted_gross_edge",
    "execution_cost",
    "net_edge"
  ],
  "title": "NetEdgeScenario",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.v5-net-edge-scenario",
  "x-aegisquant-schema-version": "1.0.0"
}
