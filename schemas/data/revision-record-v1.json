{
  "$defs": {
    "RawStorageMode": {
      "enum": [
        "ENCRYPTED_LOCAL",
        "PUBLIC_APPEND_ONLY",
        "METADATA_ONLY",
        "PROHIBITED"
      ],
      "title": "RawStorageMode",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.revision-record/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available_time": {
      "format": "date-time",
      "title": "Available Time",
      "type": "string"
    },
    "content_sha256": {
      "title": "Content Sha256",
      "type": "string"
    },
    "ingest_time": {
      "format": "date-time",
      "title": "Ingest Time",
      "type": "string"
    },
    "parent_record_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Record Id"
    },
    "payload_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Payload Path"
    },
    "provider_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Provider Id",
      "type": "string"
    },
    "provider_native_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Provider Native Id",
      "type": "string"
    },
    "record_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Record Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "source_document_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Source Document Id",
      "type": "string"
    },
    "storage_mode": {
      "$ref": "#/$defs/RawStorageMode"
    }
  },
  "required": [
    "record_id",
    "source_document_id",
    "provider_id",
    "provider_native_id",
    "revision",
    "content_sha256",
    "storage_mode",
    "payload_path",
    "available_time",
    "ingest_time"
  ],
  "title": "RevisionRecord",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.revision-record",
  "x-aegisquant-schema-version": "1.0.0"
}
