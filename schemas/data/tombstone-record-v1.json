{
  "$id": "https://aegisquant.local/schemas/aegisquant.tombstone-record/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deleted_at": {
      "format": "date-time",
      "title": "Deleted At",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Provider Id",
      "type": "string"
    },
    "reason_code": {
      "title": "Reason Code",
      "type": "string"
    },
    "required_actions": {
      "items": {
        "type": "string"
      },
      "title": "Required Actions",
      "type": "array"
    },
    "source_document_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Source Document Id",
      "type": "string"
    },
    "supersedes_record_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Record Id"
    },
    "tombstone_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Tombstone Id",
      "type": "string"
    }
  },
  "required": [
    "tombstone_id",
    "source_document_id",
    "provider_id",
    "deleted_at",
    "reason_code",
    "required_actions"
  ],
  "title": "TombstoneRecord",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.tombstone-record",
  "x-aegisquant-schema-version": "1.0.0"
}
