{
  "$defs": {
    "P12GateName": {
      "enum": [
        "TRUTH_CALIBRATION",
        "FORECAST_CALIBRATION",
        "COST_CALIBRATION",
        "PAPER",
        "SHADOW",
        "TESTNET",
        "RISK"
      ],
      "title": "P12GateName",
      "type": "string"
    },
    "P12GateStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_EXTERNAL_INPUT"
      ],
      "title": "P12GateStatus",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.v5-p12-gate-result/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence_sha256": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Evidence Sha256",
      "type": "array"
    },
    "gate": {
      "$ref": "#/$defs/P12GateName"
    },
    "reason_codes": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Z0-9][A-Z0-9_-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Reason Codes",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/P12GateStatus"
    }
  },
  "required": [
    "gate",
    "status",
    "evidence_sha256",
    "reason_codes"
  ],
  "title": "P12GateResult",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.v5-p12-gate-result",
  "x-aegisquant-schema-version": "1.0.0"
}
