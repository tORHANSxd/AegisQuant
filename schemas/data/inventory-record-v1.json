{
  "$id": "https://aegisquant.local/schemas/aegisquant.inventory-record/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "duplicate_group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate Group"
    },
    "extension": {
      "title": "Extension",
      "type": "string"
    },
    "max_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Time"
    },
    "mime_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mime Type"
    },
    "min_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Time"
    },
    "modified_time": {
      "format": "date-time",
      "title": "Modified Time",
      "type": "string"
    },
    "possible_strategy_result": {
      "title": "Possible Strategy Result",
      "type": "boolean"
    },
    "relative_path": {
      "title": "Relative Path",
      "type": "string"
    },
    "root_label": {
      "title": "Root Label",
      "type": "string"
    },
    "row_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Row Count"
    },
    "schema_json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Json"
    },
    "schema_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Sha256"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "dataset_id",
    "root_label",
    "relative_path",
    "extension",
    "size_bytes",
    "modified_time",
    "sha256",
    "possible_strategy_result"
  ],
  "title": "InventoryRecord",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.inventory-record",
  "x-aegisquant-schema-version": "1.0.0"
}
