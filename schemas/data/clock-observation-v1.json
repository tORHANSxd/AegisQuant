{
  "$id": "https://aegisquant.local/schemas/aegisquant.clock-observation/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "offset_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Offset Ms"
    },
    "provider_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Provider Id",
      "type": "string"
    },
    "request_sent_time": {
      "format": "date-time",
      "title": "Request Sent Time",
      "type": "string"
    },
    "response_received_time": {
      "format": "date-time",
      "title": "Response Received Time",
      "type": "string"
    },
    "round_trip_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Round Trip Ms"
    },
    "server_time": {
      "format": "date-time",
      "title": "Server Time",
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "request_sent_time",
    "server_time",
    "response_received_time",
    "round_trip_ms",
    "offset_ms"
  ],
  "title": "ClockObservation",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.clock-observation",
  "x-aegisquant-schema-version": "1.0.0"
}
