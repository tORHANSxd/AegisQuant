{
  "$id": "https://aegisquant.local/schemas/aegisquant.v5-no-trade-decision/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "const": "NO_TRADE",
      "default": "NO_TRADE",
      "title": "Action",
      "type": "string"
    },
    "cost_distribution_sha256": {
      "title": "Cost Distribution Sha256",
      "type": "string"
    },
    "decision_sha256": {
      "title": "Decision Sha256",
      "type": "string"
    },
    "forecast_distribution_sha256": {
      "title": "Forecast Distribution Sha256",
      "type": "string"
    },
    "live_trading_locked": {
      "const": true,
      "default": true,
      "title": "Live Trading Locked",
      "type": "boolean"
    },
    "net_edge_distribution_sha256": {
      "title": "Net Edge Distribution Sha256",
      "type": "string"
    },
    "order_submission_enabled": {
