    "AdaptiveConformalPolicy": {
      "additionalProperties": false,
      "properties": {
        "critical_shortfall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Critical Shortfall"
        },
        "maximum_adjustment_step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": "0",
          "title": "Maximum Adjustment Step"
        },
        "maximum_window_age_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": "0",
          "title": "Maximum Window Age Seconds"
        },
        "method": {
          "$ref": "#/$defs/CalibrationMethod"
        },
        "minimum_sample_count": {
          "minimum": 2,
          "title": "Minimum Sample Count",
          "type": "integer"
        },
        "target_coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Target Coverage"
        },
        "warning_shortfall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Warning Shortfall"
        }
      },
      "required": [
        "method",
        "target_coverage",
        "warning_shortfall",
        "critical_shortfall",
        "minimum_sample_count",
        "maximum_window_age_seconds",
        "maximum_adjustment_step"
      ],
      "title": "AdaptiveConformalPolicy",
      "type": "object"
    },
