{
  "$id": "https://aegisquant.local/schemas/aegisquant.engagement-snapshot/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available_time": {
      "format": "date-time",
      "title": "Available Time",
      "type": "string"
    },
    "content_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Content Id",
      "type": "string"
    },
    "engagement_snapshot_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Engagement Snapshot Id",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Metrics",
      "type": "object"
    },
    "observed_time": {
      "format": "date-time",
      "title": "Observed Time",
      "type": "string"
    }
  },
  "required": [
    "engagement_snapshot_id",
    "content_id",
    "observed_time",
    "available_time",
    "metrics"
  ],
  "title": "EngagementSnapshot",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.engagement-snapshot",
  "x-aegisquant-schema-version": "1.0.0"
}
