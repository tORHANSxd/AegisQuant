{
  "$defs": {
    "Quantity": {
      "additionalProperties": false,
      "description": "Signed asset quantity, never an unlabelled scalar.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "asset_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Asset Id",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "asset_id"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "VenueOrderStatus": {
      "enum": [
        "UNKNOWN",
        "PENDING_SUBMIT",
        "SUBMITTED",
        "ACCEPTED",
        "PARTIALLY_FILLED",
        "FILLED",
        "CANCELED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "VenueOrderStatus",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.venue-order/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_order_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Client Order Id",
      "type": "string"
    },
    "cumulative_filled_quantity": {
      "$ref": "#/$defs/Quantity"
    },
    "last_venue_update_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Venue Update At"
    },
    "locally_sent_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locally Sent At"
    },
    "order_intent_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Order Intent Id",
      "type": "string"
    },
    "rejection_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Code"
    },
    "status": {
      "$ref": "#/$defs/VenueOrderStatus"
    },
    "venue_accepted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue Accepted At"
    },
    "venue_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Venue Id",
      "type": "string"
    },
    "venue_order_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Venue Order Id"
    }
  },
  "required": [
    "venue_order_id",
    "client_order_id",
    "order_intent_id",
    "venue_id",
    "status",
    "cumulative_filled_quantity"
  ],
  "title": "VenueOrder",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.venue-order",
  "x-aegisquant-schema-version": "1.0.0"
}
