{
  "$defs": {
    "CostCalibrationMetrics": {
      "additionalProperties": false,
      "properties": {
        "mean_absolute_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "title": "Mean Absolute Error"
        },
        "mean_bias": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Mean Bias"
        },
        "mean_predicted_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "title": "Mean Predicted Cost"
        },
        "mean_realized_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "title": "Mean Realized Cost"
        },
        "sample_count": {
          "exclusiveMinimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "underprediction_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Underprediction Rate"
        }
      },
      "required": [
        "sample_count",
        "mean_predicted_cost",
        "mean_realized_cost",
        "mean_bias",
        "mean_absolute_error",
        "underprediction_rate"
      ],
      "title": "CostCalibrationMetrics",
      "type": "object"
    },
