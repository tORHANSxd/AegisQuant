{
  "$id": "https://aegisquant.local/schemas/aegisquant.backtest-instrument-rule/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approximation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approximation"
    },
    "effective_from": {
      "format": "date-time",
      "title": "Effective From",
      "type": "string"
    },
    "effective_to": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective To"
    },
    "instrument_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Instrument Id",
      "type": "string"
    },
    "instrument_rule_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Instrument Rule Id",
      "type": "string"
    },
    "maximum_quantity": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": "0"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Quantity"
    },
    "minimum_notional": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": "0",
      "title": "Minimum Notional"
    },
    "minimum_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": "0",
      "title": "Minimum Quantity"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "step_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "gt": "0",
      "title": "Step Size"
    },
    "tick_size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "gt": "0",
      "title": "Tick Size"
    },
    "trading_enabled": {
      "title": "Trading Enabled",
      "type": "boolean"
    },
    "venue_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Venue Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "instrument_rule_id",
    "version",
    "instrument_id",
    "venue_id",
    "effective_from",
    "tick_size",
    "step_size",
    "minimum_quantity",
    "minimum_notional",
    "trading_enabled",
    "source"
  ],
  "title": "HistoricalInstrumentRule",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.backtest-instrument-rule",
  "x-aegisquant-schema-version": "1.0.0"
}
