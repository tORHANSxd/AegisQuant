{
  "$defs": {
    "CouncilHorizon": {
      "enum": [
        "5s",
        "15s",
        "30s",
        "1m",
        "3m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "12h",
        "1d",
        "3d",
        "7d"
      ],
      "title": "CouncilHorizon",
      "type": "string"
    },
    "DynamicStackingPolicy": {
      "additionalProperties": false,
      "properties": {
        "maximum_ood_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "title": "Maximum Ood Score"
        },
        "maximum_single_model_weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Maximum Single Model Weight"
        },
        "maximum_weight_step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Maximum Weight Step"
        },
        "minimum_data_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Minimum Data Quality"
        },
        "minimum_model_reliability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Minimum Model Reliability"
        }
      },
      "required": [
        "maximum_single_model_weight",
        "maximum_weight_step",
        "maximum_ood_score",
        "minimum_data_quality",
        "minimum_model_reliability"
      ],
      "title": "DynamicStackingPolicy",
      "type": "object"
    },
    "MarketRegime": {
      "enum": [
        "TREND",
        "MEAN_REVERSION",
        "LOW_VOL_COMPRESSION",
        "VOL_EXPANSION",
        "LIQUIDITY_CRISIS",
        "NEWS_SHOCK",
        "LIQUIDATION_CASCADE",
        "FUNDING_DISLOCATION",
        "CORRELATION_BREAKDOWN",
        "RISK_ON",
        "RISK_OFF",
        "UNKNOWN",
        "OOD"
      ],
      "title": "MarketRegime",
      "type": "string"
    },
    "RegimeRoutingSnapshot": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Asset Id",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "data_quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Data Quality"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "horizon": {
          "$ref": "#/$defs/CouncilHorizon"
        },
        "model_reliability_by_id": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "ge": "0",
            "le": "1"
          },
          "title": "Model Reliability By Id",
          "type": "object"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "ood_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "title": "Ood Score"
        },
        "regime": {
          "$ref": "#/$defs/MarketRegime"
        },
        "snapshot_sha256": {
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "truth_state": {
          "$ref": "#/$defs/TruthState"
        }
      },
      "required": [
        "asset_id",
        "horizon",
        "regime",
        "observed_at",
        "available_at",
        "decision_time",
        "data_quality",
        "truth_state",
        "ood_score",
        "model_reliability_by_id",
        "snapshot_sha256"
      ],
      "title": "RegimeRoutingSnapshot",
      "type": "object"
    },
    "StackingWeights": {
      "additionalProperties": false,
      "properties": {
        "maximum_weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Maximum Weight"
        },
        "weights": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "ge": "0",
            "le": "1"
          },
          "title": "Weights",
          "type": "object"
        }
      },
      "required": [
        "weights",
        "maximum_weight"
      ],
      "title": "StackingWeights",
      "type": "object"
    },
    "StatisticalWeightProposal": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Asset Id",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "evidence_bindings": {
          "items": {
            "$ref": "#/$defs/WeightEvidenceBinding"
          },
          "minItems": 1,
          "title": "Evidence Bindings",
          "type": "array"
        },
        "final_holdout_used": {
          "const": false,
          "default": false,
          "title": "Final Holdout Used",
          "type": "boolean"
        },
        "horizon": {
          "$ref": "#/$defs/CouncilHorizon"
        },
        "previous_weights": {
          "$ref": "#/$defs/StackingWeights"
        },
        "proposal_sha256": {
          "title": "Proposal Sha256",
          "type": "string"
        },
        "proposed_weights": {
          "$ref": "#/$defs/StackingWeights"
        },
        "regime": {
          "$ref": "#/$defs/MarketRegime"
        },
        "split_sha256": {
          "title": "Split Sha256",
          "type": "string"
        },
        "training_cutoff": {
          "format": "date-time",
          "title": "Training Cutoff",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "horizon",
        "regime",
        "training_cutoff",
        "available_at",
        "previous_weights",
        "proposed_weights",
        "evidence_bindings",
        "split_sha256",
        "proposal_sha256"
      ],
      "title": "StatisticalWeightProposal",
      "type": "object"
    },
    "TruthState": {
      "enum": [
        "UNVERIFIED",
        "RUMOR",
        "PARTIALLY_CORROBORATED",
        "VERIFIED_PRIMARY",
        "VERIFIED_MULTI_SOURCE",
        "CONTRADICTED",
        "RETRACTED",
        "STALE",
        "UNKNOWN"
      ],
      "title": "TruthState",
      "type": "string"
    },
    "WeightEvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "title": "Artifact Sha256",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/WeightEvidenceSource"
        }
      },
      "required": [
        "source",
        "artifact_sha256"
      ],
      "title": "WeightEvidenceBinding",
      "type": "object"
    },
    "WeightEvidenceSource": {
      "enum": [
        "VALIDATION",
        "CALIBRATION",
        "FORWARD"
      ],
      "title": "WeightEvidenceSource",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.v5-regime-routing-decision/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision_sha256": {
      "title": "Decision Sha256",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/DynamicStackingPolicy"
    },
    "proposal": {
      "$ref": "#/$defs/StatisticalWeightProposal"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "selected_weights": {
      "anyOf": [
        {
          "$ref": "#/$defs/StackingWeights"
        },
        {
          "type": "null"
        }
      ]
    },
    "should_abstain": {
      "title": "Should Abstain",
      "type": "boolean"
    },
    "snapshot": {
      "$ref": "#/$defs/RegimeRoutingSnapshot"
    }
  },
  "required": [
    "snapshot",
    "proposal",
    "policy",
    "selected_weights",
    "should_abstain",
    "reason_codes",
    "decision_sha256"
  ],
  "title": "RegimeRoutingDecision",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.v5-regime-routing-decision",
  "x-aegisquant-schema-version": "1.0.0"
}
