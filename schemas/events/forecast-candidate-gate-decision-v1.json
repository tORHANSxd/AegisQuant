          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "title": "Max Train Seconds"
        },
        "max_trials": {
          "minimum": 1,
          "title": "Max Trials",
          "type": "integer"
        },
        "max_x_calls": {
          "minimum": 0,
          "title": "Max X Calls",
          "type": "integer"
        }
      },
      "required": [
        "max_trials",
        "max_train_seconds",
        "max_inference_latency_ms",
        "max_ram_mb",
        "max_gpu_memory_mb",
        "max_x_calls",
        "max_news_calls",
