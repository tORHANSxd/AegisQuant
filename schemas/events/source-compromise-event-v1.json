{
  "$defs": {
    "SourceCompromiseStatus": {
      "enum": [
        "UNKNOWN",
        "NORMAL",
        "SUSPECTED",
        "COMPROMISED",
        "RECOVERED"
      ],
      "title": "SourceCompromiseStatus",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.source-compromise-event/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "event_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Event Id",
      "type": "string"
    },
    "evidence_document_ids": {
      "default": [],
      "items": {
        "maxLength": 255,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
        "type": "string"
      },
      "title": "Evidence Document Ids",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "previous_event_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Event Id"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "source_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Source Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SourceCompromiseStatus"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "source_id",
    "version",
    "status",
    "reason_codes",
    "effective_at",
    "observed_at",
    "available_at"
  ],
  "title": "SourceCompromiseEvent",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.source-compromise-event",
  "x-aegisquant-schema-version": "1.0.0"
}
