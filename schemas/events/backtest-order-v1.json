{
  "$defs": {
    "OrderSide": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "OrderSide",
      "type": "string"
    },
    "OrderType": {
      "enum": [
        "MARKET",
        "LIMIT"
      ],
      "title": "OrderType",
      "type": "string"
    },
    "Price": {
      "additionalProperties": false,
      "description": "Positive quote-asset amount per one base-asset unit.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "gt": "0",
          "title": "Amount"
        },
        "base_asset_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Base Asset Id",
          "type": "string"
        },
        "quote_asset_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Quote Asset Id",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "base_asset_id",
        "quote_asset_id"
      ],
      "title": "Price",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "Signed asset quantity, never an unlabelled scalar.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "asset_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Asset Id",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "asset_id"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "TimeInForce": {
      "enum": [
        "GTC",
        "IOC",
        "FOK"
      ],
      "title": "TimeInForce",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.backtest-order/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backtest_order_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Backtest Order Id",
      "type": "string"
    },
    "client_order_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Client Order Id",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "instrument_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Instrument Id",
      "type": "string"
    },
    "leg_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Leg Index"
    },
    "limit_price": {
      "anyOf": [
        {
          "$ref": "#/$defs/Price"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "multi_leg_plan_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Multi Leg Plan Id"
    },
    "order_intent_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Order Intent Id",
      "type": "string"
    },
    "order_type": {
      "$ref": "#/$defs/OrderType"
    },
    "quantity": {
      "$ref": "#/$defs/Quantity"
    },
    "reduce_only": {
      "default": false,
      "title": "Reduce Only",
      "type": "boolean"
    },
    "side": {
      "$ref": "#/$defs/OrderSide"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    },
    "time_in_force": {
      "$ref": "#/$defs/TimeInForce"
    },
    "venue_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Venue Id",
      "type": "string"
    }
  },
  "required": [
    "backtest_order_id",
    "client_order_id",
    "order_intent_id",
    "instrument_id",
    "venue_id",
    "side",
    "order_type",
    "quantity",
    "time_in_force",
    "decision_time",
    "submitted_at"
  ],
  "title": "BacktestOrder",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.backtest-order",
  "x-aegisquant-schema-version": "1.0.0"
}
