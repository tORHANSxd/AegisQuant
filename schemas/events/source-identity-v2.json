{
  "$id": "https://aegisquant.local/schemas/aegisquant.source-identity/2.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available_time": {
      "format": "date-time",
      "title": "Available Time",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "first_observed_time": {
      "format": "date-time",
      "title": "First Observed Time",
      "type": "string"
    },
    "independence_group": {
      "title": "Independence Group",
      "type": "string"
    },
    "ownership_group": {
      "title": "Ownership Group",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Provider Id",
      "type": "string"
    },
    "provider_native_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Provider Native Id",
      "type": "string"
    },
    "source_identity_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Source Identity Id",
      "type": "string"
    },
    "supersedes_source_identity_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Source Identity Id"
    },
    "verified": {
      "title": "Verified",
      "type": "boolean"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "source_identity_id",
    "provider_id",
    "provider_native_id",
    "display_name",
    "ownership_group",
    "independence_group",
    "verified",
    "first_observed_time",
    "available_time"
  ],
  "title": "SourceIdentity",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.source-identity",
  "x-aegisquant-schema-version": "2.0.0"
}
