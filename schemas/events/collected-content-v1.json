{
  "$defs": {
    "ContentType": {
      "enum": [
        "POST",
        "ARTICLE",
        "ANNOUNCEMENT",
        "VIDEO_META",
        "CHANNEL_MESSAGE",
        "RELEASE",
        "FILING"
      ],
      "title": "ContentType",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "rss_atom",
        "gdelt",
        "x",
        "telegram_bot",
        "bluesky_jetstream",
        "github",
        "youtube"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.collected-content/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_url": {
      "title": "Canonical Url",
      "type": "string"
    },
    "checkpoint": {
      "title": "Checkpoint",
      "type": "string"
    },
    "content_type": {
      "$ref": "#/$defs/ContentType"
    },
    "deleted_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deleted Time"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "engagement": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Engagement",
      "type": "object"
    },
    "independence_group": {
      "title": "Independence Group",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "modified_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modified Time"
    },
    "native_id": {
      "title": "Native Id",
      "type": "string"
    },
    "observed_time": {
      "format": "date-time",
      "title": "Observed Time",
      "type": "string"
    },
    "ownership_group": {
      "title": "Ownership Group",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Provider Id",
      "type": "string"
    },
    "published_time": {
      "format": "date-time",
      "title": "Published Time",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/SourceKind"
    },
    "source_native_id": {
      "title": "Source Native Id",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "verified_source": {
      "title": "Verified Source",
      "type": "boolean"
    }
  },
  "required": [
    "source",
    "provider_id",
    "native_id",
    "source_native_id",
    "display_name",
    "ownership_group",
    "independence_group",
    "verified_source",
    "content_type",
    "canonical_url",
    "text",
    "language",
    "published_time",
    "observed_time",
    "revision",
    "checkpoint"
  ],
  "title": "CollectedContent",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.collected-content",
  "x-aegisquant-schema-version": "1.0.0"
}
