{
  "$defs": {
    "ClaimType": {
      "description": "Semantic class assigned before truth adjudication.",
      "enum": [
        "FACT",
        "FORWARD_FACT",
        "INTERPRETATION",
        "OPINION",
        "PREDICTION",
        "QUOTE",
        "RUMOR"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "EventCluster": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "claimed_event_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claimed Event Time"
        },
        "contradicting_evidence_ids": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Contradicting Evidence Ids",
          "type": "array"
        },
        "credibility_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Credibility Score"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "event_cluster_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "first_observed_time": {
          "format": "date-time",
          "title": "First Observed Time",
          "type": "string"
        },
        "independent_source_count": {
          "title": "Independent Source Count",
          "type": "integer"
        },
        "last_updated_time": {
          "format": "date-time",
          "title": "Last Updated Time",
          "type": "string"
        },
        "manipulation_risk": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Manipulation Risk"
        },
        "official_confirmation_ids": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Official Confirmation Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EventClusterStatus"
        },
        "supersedes_event_cluster_id": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Event Cluster Id"
        },
        "supporting_evidence_ids": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Uncertainty"
        }
      },
      "required": [
        "event_cluster_id",
        "event_type",
        "status",
        "entity_ids",
        "first_observed_time",
        "last_updated_time",
        "claim_ids",
        "supporting_evidence_ids",
        "contradicting_evidence_ids",
        "independent_source_count",
        "official_confirmation_ids",
        "credibility_score",
        "manipulation_risk",
        "uncertainty"
      ],
      "title": "EventCluster",
      "type": "object"
    },
    "EventClusterStatus": {
      "enum": [
        "RUMOR",
        "EMERGING",
        "CORROBORATED",
        "CONFIRMED",
        "DENIED",
        "RESOLVED"
      ],
      "title": "EventClusterStatus",
      "type": "string"
    },
    "EventSurprise": {
      "additionalProperties": false,
      "properties": {
        "actual_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Actual Value"
        },
        "as_of_time": {
          "format": "date-time",
          "title": "As Of Time",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/SurpriseDirection"
        },
        "event_cluster_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "expected_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Expected Value"
        },
        "materiality_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "title": "Materiality Threshold"
        },
        "surprise_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Surprise Id",
          "type": "string"
        },
        "surprise_sha256": {
          "title": "Surprise Sha256",
          "type": "string"
        },
        "surprise_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Surprise Value"
        },
        "value_snapshot_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Value Snapshot Id",
          "type": "string"
        },
        "value_snapshot_sha256": {
          "title": "Value Snapshot Sha256",
          "type": "string"
        },
        "value_unit": {
          "minLength": 1,
          "title": "Value Unit",
          "type": "string"
        },
        "whisper_surprise_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Whisper Surprise Value"
        },
        "whisper_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Whisper Value"
        }
      },
      "required": [
        "surprise_id",
        "event_cluster_id",
        "value_snapshot_id",
        "value_snapshot_sha256",
        "as_of_time",
        "actual_value",
        "expected_value",
        "surprise_value",
        "materiality_threshold",
        "value_unit",
        "direction",
        "surprise_sha256"
      ],
      "title": "EventSurprise",
      "type": "object"
    },
    "EventValueKind": {
      "enum": [
        "ACTUAL",
        "CONSENSUS",
        "WHISPER",
        "PRIOR_PROBABILITY"
      ],
      "title": "EventValueKind",
      "type": "string"
    },
    "EventValueSnapshot": {
      "additionalProperties": false,
      "properties": {
        "as_of_time": {
          "format": "date-time",
          "title": "As Of Time",
          "type": "string"
        },
        "event_cluster_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_sha256": {
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/TimedEventValue"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "snapshot_id",
        "event_cluster_id",
        "as_of_time",
        "values",
        "snapshot_sha256"
      ],
      "title": "EventValueSnapshot",
      "type": "object"
    },
    "MarketReflectionMetric": {
      "enum": [
        "PRE_CONFIRMATION_PRICE_MOVE",
        "ABNORMAL_RETURN",
        "VOLUME_SPIKE",
        "OPEN_INTEREST_CHANGE",
        "FUNDING_CHANGE",
        "BASIS_CHANGE",
        "OPTIONS_IV_SKEW",
        "CROSS_ASSET_RESPONSE",
        "NARRATIVE_DIFFUSION",
        "LIQUIDATION_FLOW",
        "MARKET_DEPTH_CHANGE"
      ],
      "title": "MarketReflectionMetric",
      "type": "string"
    },
    "MarketReflectionPolicy": {
      "additionalProperties": false,
      "properties": {
        "high_price_in_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "High Price In Threshold"
        },
        "max_metric_age_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Metric Age Seconds",
          "type": "integer"
        },
        "metric_weights": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "ge": "0",
            "le": "1"
          },
          "propertyNames": {
            "$ref": "#/$defs/MarketReflectionMetric"
          },
          "title": "Metric Weights",
          "type": "object"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "required_metrics": {
          "items": {
            "$ref": "#/$defs/MarketReflectionMetric"
          },
          "minItems": 1,
          "title": "Required Metrics",
          "type": "array"
        }
      },
      "required": [
        "policy_version",
        "required_metrics",
        "metric_weights",
        "high_price_in_threshold",
        "max_metric_age_seconds"
      ],
      "title": "MarketReflectionPolicy",
      "type": "object"
    },
    "MarketReflectionScore": {
      "additionalProperties": false,
      "properties": {
        "already_priced_probability": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0",
              "le": "1"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Already Priced Probability"
        },
        "as_of_time": {
          "format": "date-time",
          "title": "As Of Time",
          "type": "string"
        },
        "event_cluster_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "high_price_in": {
          "title": "High Price In",
          "type": "boolean"
        },
        "market_reflection_score": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0",
              "le": "1"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Reflection Score"
        },
        "method": {
          "const": "DEVELOPMENT_WEIGHTED_SCORE_V1",
          "default": "DEVELOPMENT_WEIGHTED_SCORE_V1",
          "title": "Method",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/TimedMarketReflectionMetric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "missing_metrics": {
          "items": {
            "$ref": "#/$defs/MarketReflectionMetric"
          },
          "title": "Missing Metrics",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/MarketReflectionPolicy"
        },
        "promotion_eligible": {
          "const": false,
          "default": false,
          "title": "Promotion Eligible",
          "type": "boolean"
        },
        "quality_state": {
          "$ref": "#/$defs/QualityState"
        },
        "reflection_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Reflection Id",
          "type": "string"
        },
        "reflection_sha256": {
          "title": "Reflection Sha256",
          "type": "string"
        },
        "stale_metric_ids": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
            "type": "string"
          },
          "title": "Stale Metric Ids",
          "type": "array"
        }
      },
      "required": [
        "reflection_id",
        "event_cluster_id",
        "as_of_time",
        "policy",
        "metrics",
        "missing_metrics",
        "stale_metric_ids",
        "high_price_in",
        "quality_state",
        "reflection_sha256"
      ],
      "title": "MarketReflectionScore",
      "type": "object"
    },
    "NarrativeDiffusionObservation": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "event_cluster_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "independence_group": {
          "minLength": 1,
          "title": "Independence Group",
          "type": "string"
        },
        "kol_source": {
          "default": false,
          "title": "Kol Source",
          "type": "boolean"
        },
        "language": {
          "maxLength": 35,
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "news_wire_source": {
          "default": false,
          "title": "News Wire Source",
          "type": "boolean"
        },
        "observation_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Observation Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "verified_source": {
          "title": "Verified Source",
          "type": "boolean"
        }
      },
      "required": [
        "observation_id",
        "event_cluster_id",
        "source_id",
        "independence_group",
        "platform",
        "language",
        "verified_source",
        "observed_at",
        "available_at",
        "source_sha256"
      ],
      "title": "NarrativeDiffusionObservation",
      "type": "object"
    },
    "NarrativeDiffusionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "as_of_time": {
          "format": "date-time",
          "title": "As Of Time",
          "type": "string"
        },
        "diffusion_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Diffusion Id",
          "type": "string"
        },
        "diffusion_sha256": {
          "title": "Diffusion Sha256",
          "type": "string"
        },
        "event_cluster_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "first_observed_at": {
          "format": "date-time",
          "title": "First Observed At",
          "type": "string"
        },
        "first_source_id": {
          "minLength": 1,
          "title": "First Source Id",
          "type": "string"
        },
        "first_verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Verified At"
        },
        "first_verified_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Verified Source Id"
        },
        "independent_source_count": {
          "minimum": 1,
          "title": "Independent Source Count",
          "type": "integer"
        },
        "independent_source_velocity_per_hour": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "title": "Independent Source Velocity Per Hour"
        },
        "kol_count": {
          "minimum": 0,
          "title": "Kol Count",
          "type": "integer"
        },
        "language_count": {
          "minimum": 1,
          "title": "Language Count",
          "type": "integer"
        },
        "news_wire_count": {
          "minimum": 0,
          "title": "News Wire Count",
          "type": "integer"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/NarrativeDiffusionObservation"
          },
          "minItems": 1,
          "title": "Observations",
          "type": "array"
        },
        "platform_count": {
          "minimum": 1,
          "title": "Platform Count",
          "type": "integer"
        },
        "price_response_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Response At"
        },
        "price_response_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Response Available At"
        },
        "price_response_lag_seconds": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Response Lag Seconds"
        },
        "price_response_source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Response Source Sha256"
        },
        "propagation_stage": {
          "$ref": "#/$defs/NarrativePropagationStage"
        },
        "source_velocity_per_hour": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "title": "Source Velocity Per Hour"
        },
        "volume_response_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume Response At"
        },
        "volume_response_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume Response Available At"
        },
        "volume_response_lag_seconds": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume Response Lag Seconds"
        },
        "volume_response_source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
