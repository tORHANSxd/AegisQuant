{
  "$defs": {
    "SnapshotAmount": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "amount"
      ],
      "title": "SnapshotAmount",
      "type": "object"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.venue-account-snapshot/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_snapshot_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Account Snapshot Id",
      "type": "string"
    },
    "as_of_time": {
      "format": "date-time",
      "title": "As Of Time",
      "type": "string"
    },
    "balances": {
      "items": {
        "$ref": "#/$defs/SnapshotAmount"
      },
      "title": "Balances",
      "type": "array"
    },
    "fees": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SnapshotAmount"
      },
      "title": "Fees",
      "type": "array"
    },
    "fill_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fill Ids",
      "type": "array"
    },
    "funding": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SnapshotAmount"
      },
      "title": "Funding",
      "type": "array"
    },
    "open_order_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Open Order Ids",
      "type": "array"
    },
    "positions": {
      "items": {
        "$ref": "#/$defs/SnapshotAmount"
      },
      "title": "Positions",
      "type": "array"
    },
    "recent_order_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Recent Order Ids",
      "type": "array"
    },
    "venue": {
      "title": "Venue",
      "type": "string"
    }
  },
  "required": [
    "account_snapshot_id",
    "venue",
    "as_of_time",
    "balances",
    "positions"
  ],
  "title": "VenueAccountSnapshot",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.venue-account-snapshot",
  "x-aegisquant-schema-version": "1.0.0"
}
