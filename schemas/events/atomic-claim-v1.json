{
  "$defs": {
    "ClaimSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "ClaimSpan",
      "type": "object"
    },
    "ClaimType": {
      "description": "Semantic class assigned before truth adjudication.",
      "enum": [
        "FACT",
        "FORWARD_FACT",
        "INTERPRETATION",
        "OPINION",
        "PREDICTION",
        "QUOTE",
        "RUMOR"
      ],
      "title": "ClaimType",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.atomic-claim/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An exact text span classified before it reaches truth or impact logic.",
  "properties": {
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "claim_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Claim Id",
      "type": "string"
    },
    "claim_type": {
      "$ref": "#/$defs/ClaimType"
    },
    "entity_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Entity Ids",
      "type": "array"
    },
    "event_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Time"
    },
    "first_seen_time": {
      "format": "date-time",
      "title": "First Seen Time",
      "type": "string"
    },
    "ingested_time": {
      "format": "date-time",
      "title": "Ingested Time",
      "type": "string"
    },
    "language": {
      "maxLength": 35,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "normalized_text": {
      "minLength": 1,
      "title": "Normalized Text",
      "type": "string"
    },
    "original_text": {
      "minLength": 1,
      "title": "Original Text",
      "type": "string"
    },
    "published_time": {
      "format": "date-time",
      "title": "Published Time",
      "type": "string"
    },
    "revision_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Revision Id",
      "type": "string"
    },
    "source_document_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Source Document Id",
      "type": "string"
    },
    "source_identity_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Source Identity Id",
      "type": "string"
    },
    "span": {
      "$ref": "#/$defs/ClaimSpan"
    },
    "translation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation"
    }
  },
  "required": [
    "claim_id",
    "source_document_id",
    "source_identity_id",
    "revision_id",
    "claim_type",
    "original_text",
    "normalized_text",
    "span",
    "language",
    "entity_ids",
    "published_time",
    "first_seen_time",
    "available_at",
    "ingested_time"
  ],
  "title": "AtomicClaim",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.atomic-claim",
  "x-aegisquant-schema-version": "1.0.0"
}
