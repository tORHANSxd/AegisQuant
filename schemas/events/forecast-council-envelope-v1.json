  "$id": "https://aegisquant.local/schemas/aegisquant.forecast-council-envelope/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "abstain_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Abstain Reasons",
      "type": "array"
    },
    "action": {
      "const": "RESEARCH_PROPOSAL_ONLY",
      "default": "RESEARCH_PROPOSAL_ONLY",
      "title": "Action",
      "type": "string"
    },
    "alpha_promotion_eligible": {
      "const": false,
      "default": false,
      "title": "Alpha Promotion Eligible",
      "type": "boolean"
    },
    "as_of_time": {
      "format": "date-time",
      "title": "As Of Time",
      "type": "string"
    },
    "asset_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Asset Id",
      "type": "string"
    },
    "calibration_artifact_sha256_by_horizon": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "$ref": "#/$defs/CouncilHorizon"
      },
      "title": "Calibration Artifact Sha256 By Horizon",
      "type": "object"
    },
    "dataset_manifest_sha256": {
      "title": "Dataset Manifest Sha256",
      "type": "string"
    },
    "evidence_tier": {
      "const": "DEVELOPMENT",
      "default": "DEVELOPMENT",
      "title": "Evidence Tier",
      "type": "string"
    },
    "forecast_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Forecast Id",
      "type": "string"
    },
    "forecast_sha256": {
      "title": "Forecast Sha256",
      "type": "string"
    },
    "horizons": {
      "items": {
        "$ref": "#/$defs/HorizonForecast"
      },
      "minItems": 1,
      "title": "Horizons",
      "type": "array"
    },
    "instrument_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Instrument Id",
      "type": "string"
    },
    "live_trading_locked": {
      "const": true,
      "default": true,
      "title": "Live Trading Locked",
      "type": "boolean"
    },
    "market_state_tensor_sha256": {
      "title": "Market State Tensor Sha256",
      "type": "string"
    },
    "model_capability_sha256": {
      "title": "Model Capability Sha256",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_revision": {
      "title": "Model Revision",
      "type": "string"
    },
    "order_submission_enabled": {
      "const": false,
      "default": false,
      "title": "Order Submission Enabled",
      "type": "boolean"
    },
    "prediction_mode": {
      "$ref": "#/$defs/PredictionMode"
    },
    "regime": {
      "$ref": "#/$defs/MarketRegime"
    },
    "should_abstain": {
      "title": "Should Abstain",
      "type": "boolean"
    }
  },
  "required": [
    "forecast_id",
    "model_id",
    "model_revision",
    "model_capability_sha256",
    "market_state_tensor_sha256",
    "dataset_manifest_sha256",
    "calibration_artifact_sha256_by_horizon",
    "instrument_id",
    "asset_id",
    "as_of_time",
    "regime",
    "prediction_mode",
    "horizons",
    "should_abstain",
    "abstain_reasons",
    "forecast_sha256"
  ],
  "title": "ForecastEnvelope",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.forecast-council-envelope",
  "x-aegisquant-schema-version": "1.0.0"
}
