{
  "$defs": {
    "EngineKind": {
      "enum": [
        "VECTOR",
        "EVENT"
      ],
      "title": "EngineKind",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "description": "Signed monetary amount denominated in one explicit asset.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "asset_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Asset Id",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "asset_id"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.backtest-run-spec/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Content-addressed deterministic run declaration.",
  "properties": {
    "accounting_policy_version": {
      "title": "Accounting Policy Version",
      "type": "string"
    },
    "code_sha256": {
      "title": "Code Sha256",
      "type": "string"
    },
    "config_sha256": {
      "title": "Config Sha256",
      "type": "string"
    },
    "cost_policy_version": {
      "title": "Cost Policy Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_sha256": {
      "title": "Dataset Sha256",
      "type": "string"
    },
    "end_time": {
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "engine_kind": {
      "$ref": "#/$defs/EngineKind"
    },
    "initial_cash": {
      "$ref": "#/$defs/Money"
    },
    "live_trading_locked": {
      "const": true,
      "default": true,
      "title": "Live Trading Locked",
      "type": "boolean"
    },
    "reporting_asset_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Reporting Asset Id",
      "type": "string"
    },
    "reproduction_command": {
      "title": "Reproduction Command",
      "type": "string"
    },
    "rule_policy_version": {
      "title": "Rule Policy Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Run Id",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "start_time": {
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "strategy_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Strategy Id",
      "type": "string"
    },
    "strategy_version_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Strategy Version Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "engine_kind",
    "strategy_id",
    "strategy_version_id",
    "dataset_sha256",
    "config_sha256",
    "code_sha256",
    "seed",
    "reporting_asset_id",
    "initial_cash",
    "start_time",
    "end_time",
    "created_at",
    "accounting_policy_version",
    "cost_policy_version",
    "rule_policy_version",
    "reproduction_command"
  ],
  "title": "BacktestRunSpec",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.backtest-run-spec",
  "x-aegisquant-schema-version": "1.0.0"
}
