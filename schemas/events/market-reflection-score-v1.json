{
  "$defs": {
    "MarketReflectionMetric": {
      "enum": [
        "PRE_CONFIRMATION_PRICE_MOVE",
        "ABNORMAL_RETURN",
        "VOLUME_SPIKE",
        "OPEN_INTEREST_CHANGE",
        "FUNDING_CHANGE",
        "BASIS_CHANGE",
        "OPTIONS_IV_SKEW",
        "CROSS_ASSET_RESPONSE",
        "NARRATIVE_DIFFUSION",
        "LIQUIDATION_FLOW",
        "MARKET_DEPTH_CHANGE"
      ],
      "title": "MarketReflectionMetric",
      "type": "string"
    },
    "MarketReflectionPolicy": {
      "additionalProperties": false,
      "properties": {
        "high_price_in_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "High Price In Threshold"
        },
        "max_metric_age_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Metric Age Seconds",
          "type": "integer"
        },
        "metric_weights": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "ge": "0",
            "le": "1"
          },
          "propertyNames": {
            "$ref": "#/$defs/MarketReflectionMetric"
          },
          "title": "Metric Weights",
          "type": "object"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "required_metrics": {
          "items": {
            "$ref": "#/$defs/MarketReflectionMetric"
          },
          "minItems": 1,
          "title": "Required Metrics",
          "type": "array"
        }
      },
      "required": [
        "policy_version",
        "required_metrics",
        "metric_weights",
        "high_price_in_threshold",
        "max_metric_age_seconds"
      ],
      "title": "MarketReflectionPolicy",
      "type": "object"
    },
    "QualityState": {
      "enum": [
        "GOOD",
        "DEGRADED",
        "STALE",
        "INVALID"
      ],
      "title": "QualityState",
      "type": "string"
    },
    "TimedMarketReflectionMetric": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "event_cluster_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "metric": {
          "$ref": "#/$defs/MarketReflectionMetric"
        },
        "metric_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Metric Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "reflection_strength": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1",
          "title": "Reflection Strength"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "event_cluster_id",
        "metric",
        "reflection_strength",
        "observed_at",
        "available_at",
        "source_id",
        "source_sha256"
      ],
      "title": "TimedMarketReflectionMetric",
      "type": "object"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.market-reflection-score/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "already_priced_probability": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Already Priced Probability"
    },
    "as_of_time": {
      "format": "date-time",
      "title": "As Of Time",
      "type": "string"
    },
    "event_cluster_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Event Cluster Id",
      "type": "string"
    },
    "high_price_in": {
      "title": "High Price In",
      "type": "boolean"
    },
    "market_reflection_score": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0",
          "le": "1"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market Reflection Score"
    },
    "method": {
      "const": "DEVELOPMENT_WEIGHTED_SCORE_V1",
      "default": "DEVELOPMENT_WEIGHTED_SCORE_V1",
      "title": "Method",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/TimedMarketReflectionMetric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "missing_metrics": {
      "items": {
        "$ref": "#/$defs/MarketReflectionMetric"
      },
      "title": "Missing Metrics",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/MarketReflectionPolicy"
    },
    "promotion_eligible": {
      "const": false,
      "default": false,
      "title": "Promotion Eligible",
      "type": "boolean"
    },
    "quality_state": {
      "$ref": "#/$defs/QualityState"
    },
    "reflection_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Reflection Id",
      "type": "string"
    },
    "reflection_sha256": {
      "title": "Reflection Sha256",
      "type": "string"
    },
    "stale_metric_ids": {
      "items": {
        "maxLength": 255,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
        "type": "string"
      },
      "title": "Stale Metric Ids",
      "type": "array"
    }
  },
  "required": [
    "reflection_id",
    "event_cluster_id",
    "as_of_time",
    "policy",
    "metrics",
    "missing_metrics",
    "stale_metric_ids",
    "high_price_in",
    "quality_state",
    "reflection_sha256"
  ],
  "title": "MarketReflectionScore",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.market-reflection-score",
  "x-aegisquant-schema-version": "1.0.0"
}
