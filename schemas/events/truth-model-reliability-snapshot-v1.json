{
  "$defs": {
    "TruthModelLifecycleState": {
      "enum": [
        "NORMAL",
        "DEGRADED",
        "RESTRICTED",
        "RETIRED"
      ],
      "title": "TruthModelLifecycleState",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.truth-model-reliability-snapshot/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_confirmed_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": "0",
      "le": "1",
      "title": "Actual Confirmed Rate"
    },
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "calibration_gap": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": "0",
      "title": "Calibration Gap"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "high_confidence_sample_count": {
      "minimum": 0,
      "title": "High Confidence Sample Count",
      "type": "integer"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "outcomes_available_at": {
      "format": "date-time",
      "title": "Outcomes Available At",
      "type": "string"
    },
    "policy_version": {
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "predicted_high_confidence_mean": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "ge": "0",
      "le": "1",
      "title": "Predicted High Confidence Mean"
    },
    "previous_snapshot_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Snapshot Id"
    },
    "previous_snapshot_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Snapshot Sha256"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "snapshot_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/TruthModelLifecycleState"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "model_id",
    "state",
    "predicted_high_confidence_mean",
    "actual_confirmed_rate",
    "high_confidence_sample_count",
    "calibration_gap",
    "policy_version",
    "reason_codes",
    "outcomes_available_at",
    "created_at",
    "available_at",
    "version"
  ],
  "title": "TruthModelReliabilitySnapshot",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.truth-model-reliability-snapshot",
  "x-aegisquant-schema-version": "1.0.0"
}
