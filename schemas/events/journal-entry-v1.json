{
  "$defs": {
    "LedgerPosting": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Account Id",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "memo": {
          "title": "Memo",
          "type": "string"
        },
        "posting_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Posting Id",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/PostingSide"
        }
      },
      "required": [
        "posting_id",
        "account_id",
        "side",
        "amount",
        "memo"
      ],
      "title": "LedgerPosting",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "Signed monetary amount denominated in one explicit asset.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "asset_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Asset Id",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "asset_id"
      ],
      "title": "Money",
      "type": "object"
    },
    "PostingSide": {
      "enum": [
        "DEBIT",
        "CREDIT"
      ],
      "title": "PostingSide",
      "type": "string"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.journal-entry/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "journal_entry_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Journal Entry Id",
      "type": "string"
    },
    "postings": {
      "items": {
        "$ref": "#/$defs/LedgerPosting"
      },
      "title": "Postings",
      "type": "array"
    },
    "reconciliation_adjustment": {
      "default": false,
      "title": "Reconciliation Adjustment",
      "type": "boolean"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "supersedes_entry_id": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Entry Id"
    }
  },
  "required": [
    "journal_entry_id",
    "event_time",
    "recorded_at",
    "description",
    "postings"
  ],
  "title": "JournalEntry",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.journal-entry",
  "x-aegisquant-schema-version": "1.0.0"
}
