{
  "$defs": {
    "EventValueKind": {
      "enum": [
        "ACTUAL",
        "CONSENSUS",
        "WHISPER",
        "PRIOR_PROBABILITY"
      ],
      "title": "EventValueKind",
      "type": "string"
    },
    "TimedEventValue": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "event_cluster_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EventValueKind"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source_artifact_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Source Artifact Id",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "value_id": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
          "title": "Value Id",
          "type": "string"
        }
      },
      "required": [
        "value_id",
        "event_cluster_id",
        "kind",
        "value",
        "unit",
        "observed_at",
        "available_at",
        "source_artifact_id",
        "source_sha256"
      ],
      "title": "TimedEventValue",
      "type": "object"
    }
  },
  "$id": "https://aegisquant.local/schemas/aegisquant.event-value-snapshot/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of_time": {
      "format": "date-time",
      "title": "As Of Time",
      "type": "string"
    },
    "event_cluster_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Event Cluster Id",
      "type": "string"
    },
    "snapshot_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_sha256": {
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/TimedEventValue"
      },
      "minItems": 1,
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "event_cluster_id",
    "as_of_time",
    "values",
    "snapshot_sha256"
  ],
  "title": "EventValueSnapshot",
  "type": "object",
  "x-aegisquant-schema-name": "aegisquant.event-value-snapshot",
  "x-aegisquant-schema-version": "1.0.0"
}
