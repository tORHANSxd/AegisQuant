{
  "name": "@aegisquant/web",
  "version": "3.1.0-dev.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "api:generate": "openapi-ts -f openapi-ts.config.ts",
    "build": "next build",
    "build-storybook": "storybook build --quiet --disable-telemetry",
    "dev": "next dev --hostname 127.0.0.1",
    "e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "start": "next start --hostname 127.0.0.1",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "lightweight-charts": "5.2.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/nextjs": "10.5.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "webpack": "5.109.2"
  }
}
